<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="pl-PL" Codepage="1250" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="LaunchApp" Value="Uruchom HomePodCast" />
  <String Id="DotNetMissing" Value="HomePodCast wymaga środowiska .NET 10 Desktop Runtime (x64). Pobierz je ze strony https://dotnet.microsoft.com/download/dotnet/10.0, zainstaluj, a następnie ponownie uruchom tę instalację." />
  <String Id="DowngradeError" Value="Nowsza wersja HomePodCast jest już zainstalowana. Aby zainstalować tę starszą wersję, najpierw odinstaluj HomePodCast (ustawienia zostaną zachowane)." />
  <String Id="ShortcutDescription" Value="Przesyłaj dźwięk z tego komputera do głośnika HomePod" />
  <String Id="FirewallRuleDescription" Value="Pozwala głośnikom AirPlay w sieci lokalnej łączyć się z powrotem z HomePodCast (synchronizacja zegara, żądania ponownego przesłania pakietów). Reguła jest usuwana podczas odinstalowywania HomePodCast." />
</WixLocalization>
