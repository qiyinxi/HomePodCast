  <String Id="LaunchApp" Value="Lancer HomePodCast" />
  <String Id="DotNetMissing" Value="HomePodCast nécessite .NET 10 Desktop Runtime (x64). Téléchargez-le depuis https://dotnet.microsoft.com/download/dotnet/10.0, installez-le, puis relancez ce programme d'installation." />
  <String Id="DowngradeError" Value="Une version plus récente de HomePodCast est déjà installée. Pour installer cette version plus ancienne, désinstallez d'abord HomePodCast (vos paramètres sont conservés)." />
  <String Id="ShortcutDescription" Value="Diffuser le son de ce PC vers un HomePod" />
  <String Id="FirewallRuleDescription" Value="Permet aux enceintes AirPlay du réseau local de se reconnecter à HomePodCast (synchronisation de l'horloge, demandes de retransmission). Cette règle est supprimée lors de la désinstallation de HomePodCast." />

