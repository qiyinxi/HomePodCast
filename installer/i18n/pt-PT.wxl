  <String Id="LaunchApp" Value="Iniciar o HomePodCast" />
  <String Id="DotNetMissing" Value="O HomePodCast precisa do .NET 10 Desktop Runtime (x64). Transfira-o a partir de https://dotnet.microsoft.com/download/dotnet/10.0, instale-o e volte a executar esta configuração." />
  <String Id="DowngradeError" Value="Já está instalada uma versão mais recente do HomePodCast. Para instalar esta versão mais antiga, desinstale primeiro o HomePodCast (as definições são mantidas)." />
  <String Id="ShortcutDescription" Value="Transmitir o som deste PC para um HomePod" />
  <String Id="FirewallRuleDescription" Value="Permite que as colunas AirPlay da rede local se liguem de volta ao HomePodCast (sincronização do relógio, pedidos de retransmissão). É removida quando o HomePodCast é desinstalado." />

