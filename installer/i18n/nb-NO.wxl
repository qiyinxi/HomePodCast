  <String Id="WixRollbackFirewallExceptionsInstall" Value="Tilbakestiller endringer i Windows-brannmuren" />
  <String Id="WixExecFirewallExceptionsInstall" Value="Legger til regler i Windows-brannmuren" />
  <String Id="WixRollbackFirewallExceptionsUninstall" Value="Tilbakestiller endringer i Windows-brannmuren" />
  <String Id="WixExecFirewallExceptionsUninstall" Value="Fjerner regler fra Windows-brannmuren" />
