<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HomePodCast</RootNamespace>
    <AssemblyName>HomePodCast</AssemblyName>
    <Version>0.2.0</Version>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The custom controls (UI/Controls) are built in code, never in the designer: no serialization attributes. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Fixed output location so the firewall rule for the exe survives rebuilds. -->
    <OutputPath>..\app\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HomePodCast.Tests" />
  </ItemGroup>

  <!-- UI translations (source string → text), read by L.cs as i18n.<language>.json -->
  <ItemGroup>
    <None Remove="i18n\**" />
    <EmbeddedResource Include="i18n\*.json" LogicalName="i18n.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
