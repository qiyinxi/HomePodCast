<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HomePodCast.VideoWindow</AssemblyName>
    <!-- As the main app: without it the module is system-aware and Windows stretches it again (blurred) on a monitor
         whose scale differs from the primary one. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/L.cs" Link="L.cs" />
    <EmbeddedResource Include="../../src/i18n/*.json" LogicalName="i18n.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
