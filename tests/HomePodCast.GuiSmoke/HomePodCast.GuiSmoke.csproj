<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GUI smoke test (CI job gui-smoke in .github/workflows/build.yml): starts a Release HomePodCast.exe with test configs,
    walks every page and the main dialogs through UI Automation, checks the layout and the log, and saves screenshots.
    It launches the real app, which would connect to a speaker on the network: it refuses to run outside CI unless
    asked to (see Program.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIAutomationClient / UIAutomationTypes (System.Windows.Automation) -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>HomePodCast.GuiSmoke</RootNamespace>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the fake AirPlay receiver below (protocol types); the app under test is the exe given with dash-dash-app. -->
    <ProjectReference Include="..\..\src\HomePodCast.csproj" />
    <Compile Include="..\HomePodCast.Tests\FakeAirPlayReceiver.cs" Link="Fakes\FakeAirPlayReceiver.cs" />
    <Compile Include="..\HomePodCast.Tests\FakeReceiver.cs" Link="Fakes\FakeReceiver.cs" />
    <Compile Include="..\HomePodCast.Tests\FakeDlnaRenderer.cs" Link="Fakes\FakeDlnaRenderer.cs" />
    <Compile Include="..\Shared\MixerScenario.cs" Link="Fakes\MixerScenario.cs" />
    <!-- The UI texts, to find controls by what they say in each language. -->
    <None Include="..\..\src\i18n\*.json" Link="i18n\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF leaves System.IO out of the implicit usings (WPF has a Path of its own). -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
